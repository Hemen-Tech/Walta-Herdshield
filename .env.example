# Copy this file to .env and fill in your Africa's Talking Sandbox credentials.
AT_ENVIRONMENT=sandbox
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# Use a random secret of at least 32 characters for the inbound SMS callback.
SMS_WEBHOOK_SECRET=
ADMIN_KEY=

# Optional fixed Sandbox stakeholder identities. Keep actual phone numbers in
# the ignored .env.stakeholders file or set them in the hosting environment.
SMS_STAKEHOLDER_PASTORALIST_1=
SMS_STAKEHOLDER_PASTORALIST_2=
SMS_STAKEHOLDER_PASTORALIST_3=
SMS_STAKEHOLDER_LIVESTOCK_OWNER=
SMS_STAKEHOLDER_VETERINARIAN=
SMS_STAKEHOLDER_NGO=
SMS_STAKEHOLDER_GOVERNMENT=
